# Modele de configuration. Copier ce fichier en .env puis changer les valeurs.
# Le fichier .env ne doit JAMAIS etre envoye dans Git.

# --- Base de donnees (Docker) ---
POSTGRES_USER=avis_admin
POSTGRES_PASSWORD=TON_MOT_DE_PASSE
POSTGRES_DB=plateforme_avis
POSTGRES_PORT=5432

# --- Application ---
# Adresse de la base (le mot de passe doit etre le meme que ci-dessus).
DATABASE_URL=postgresql://avis_admin:TON_MOT_DE_PASSE@localhost:5432/plateforme_avis
# Port du serveur.
PORT=3000
# Adresses autorisees a appeler l'API, separees par des virgules.
ORIGINES_AUTORISEES=http://localhost:5173
# Adresse publique du site : c'est elle qui est ecrite dans les QR codes.
PUBLIC_BASE_URL=http://localhost:5173