# Modele de configuration du backend.
# Copier ce fichier en .env puis remplacer TON_MOT_DE_PASSE
# par le meme mot de passe que dans le .env de la racine.
# Le fichier .env ne doit JAMAIS etre envoye dans Git.

DATABASE_URL="postgresql://avis_admin:TON_MOT_DE_PASSE@localhost:5432/plateforme_avis?schema=public"
PORT=3000
ORIGINES_AUTORISEES=http://localhost:5173,http://localhost:5174
SEED_ADMIN_EMAIL=admin@exemple.tg
SEED_ADMIN_MOT_DE_PASSE=CHANGER_MOT_DE_PASSE_ADMIN
SEED_RESPONSABLE_EMAIL=responsable@exemple.tg
SEED_RESPONSABLE_MOT_DE_PASSE=CHANGER_MOT_DE_PASSE_RESPONSABLE
SEL_EMPREINTE=CHANGER_SEL_SECRET_LONG

# Adresse de la page d'avis du client (jour 8). Le QR code contient PUBLIC_BASE_URL/q/{code}.
# En local : le serveur de la page d'avis (Vite). A remplacer par l'adresse definitive au jour 25,
# avant d'imprimer le moindre chevalet.
PUBLIC_BASE_URL=http://localhost:5173

# Adresse du tableau de bord (jour 13). Les liens des e-mails (mot de passe oublie,
# invitations, alertes) pointent vers cette adresse. A remplacer par l'adresse definitive au jour 25.
TABLEAU_DE_BORD_URL=http://localhost:5174

# Envoi d'e-mails (jour 13). En local : Mailpit (docker compose --profile dev up -d mailpit),
# les messages se lisent sur http://localhost:8025 et ne partent jamais vraiment.
# Au jour 16 : remplacer par le service d'e-mails choisi (Brevo, Mailgun...), avec l'accord de DTS.
SMTP_HOTE=localhost
SMTP_PORT=1025
SMTP_SECURISE=false
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
EMAIL_EXPEDITEUR="Avis clients <avis@exemple.tg>"