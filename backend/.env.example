# Modele de configuration du backend.
# Copier ce fichier en .env puis remplacer TON_MOT_DE_PASSE
# par le meme mot de passe que dans le .env de la racine.
# Le fichier .env ne doit JAMAIS etre envoye dans Git.

DATABASE_URL="postgresql://avis_admin:TON_MOT_DE_PASSE@localhost:5432/plateforme_avis?schema=public"
PORT=3000
ORIGINES_AUTORISEES=http://localhost:5173,http://localhost:5174
SEED_ADMIN_EMAIL=admin@exemple.tg
SEED_ADMIN_MOT_DE_PASSE=CHANGER_MOT_DE_PASSE_ADMIN
SEED_RESPONSABLE_EMAIL=responsable@exemple.tg
SEED_RESPONSABLE_MOT_DE_PASSE=CHANGER_MOT_DE_PASSE_RESPONSABLE
